# Copy to ~/.fitlog/key.properties (C:\Users\<you>\.fitlog on Windows), next
# to the keystore, and fill in. Outside the project, cleaning or deleting the
# project cannot take the key along (DECISIONS 308). android/key.properties
# works too, and git ignores it: it holds the password to the signing key.
#
# Make the key once, and keep both the file and the password somewhere you will
# still have them in five years:
#
#   keytool -genkey -v -keystore fitlog-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias fitlog
#
# Lose it and nobody can ever update the app again: Android refuses an APK whose
# signature changed, and reinstalling means losing every workout on the device,
# because there is no server holding a copy.

# Read from the folder this file is in.
storeFile=fitlog-release.jks
storePassword= 
keyAlias=fitlog
keyPassword=
