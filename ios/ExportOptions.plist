<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only by the signed job in .github/workflows/ios.yml.

  __TEAM_ID__ is a placeholder. The workflow replaces it with the APPLE_TEAM_ID
  secret before handing this file to `flutter build ipa`, so nothing here has to
  hold a real team identifier. Find yours at
  https://developer.apple.com/account under Membership details.

  method `development` builds an app for devices listed on your provisioning
  profile. Change it to `ad-hoc` for wider internal distribution, or
  `app-store` when you actually submit - each needs a matching profile.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>development</string>

	<key>teamID</key>
	<string>__TEAM_ID__</string>

	<key>signingStyle</key>
	<string>manual</string>

	<key>compileBitcode</key>
	<false/>

	<key>stripSwiftSymbols</key>
	<true/>

	<key>uploadSymbols</key>
	<false/>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
